   "source": [
    "def show_sequence(n):\n",
    "    lst = [str(x) for x in range(n+1)]\n",
    "    return \"+\".join(lst)+\" = \"+str(sum(int(x) for x in lst))\n",
    "show_sequence(6)"
   ]
  },
