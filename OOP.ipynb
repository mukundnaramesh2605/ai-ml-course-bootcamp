    "    def __init__(self, name, age):\n",
    "        self.name = name\n",
    "        self.age = age\n",
    "\n",
    "    def bark(self):\n",
    "        print(f\"{self.name} says Woof!\")\n",
    "\n",
    "d1 = Dog(\"Rex\", 3)\n",
    "d2 = Dog(\"Bella\", 5)\n",
    "d1.bark()\n",
    "d2.bark()"
