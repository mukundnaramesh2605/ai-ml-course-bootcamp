   "source": [
    "# 1. Sum of Squares  [Service / logic]\n",
    "# Return the sum of the squares of the numbers.\n",
    "# [1,2,3] -> 14\n",
    "def sum_squares(nums):\n",
    "    return sum([x**2 for x in nums])\n",
    "print(sum_squares([1,2,3]))# -> 14 ; sum_squares([]) -> 0"
   ]
