   "source": [
    "# 1. Sum Positive Only  [logic]\n",
    "# Return the sum of only the positive numbers (strictly > 0).\n",
    "def sum_positive(nums):\n",
    "    return sum([x for x in nums if x>0])\n",
    "print(sum_positive([3, -1, 4, -2, 0]))   # -> 7\n",
    "print(sum_positive([-1, -2]))            # -> 0\n",
    "print(sum_positive([]))       "
   ]
