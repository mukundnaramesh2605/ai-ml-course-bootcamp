    "# 1. Count Letters Only  [Service / screening]\n",
    "# Count how many alphabetic characters are in a string, ignoring digits and spaces.\n",
    "# Example: \"abc 123 xy\" -> 5\n",
    "s = \"code42 is fun99\"\n",
    "print(sum([1 for i in s if i.isalpha()]))"
   ]
