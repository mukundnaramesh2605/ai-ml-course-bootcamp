   "source": [
    "# 1. Two Sum (Easy)\n",
    "# Return indices of two numbers that add up to target.\n",
    "def two_sum(nums, target):\n",
    "    seen = {}\n",
    "    for i, n in enumerate(nums):\n",
    "        if target - n in seen:\n",
    "            return [seen[target - n], i]\n",
    "        seen[n] = i\n",
    "\n",
    "print(two_sum([2, 7, 11, 15], 9))  # [0, 1]"
   ]
  },
