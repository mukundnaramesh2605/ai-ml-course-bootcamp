   "source": [
    "# ============ PYTHON (1-10) ============\n",
    "\n",
    "# 1. Sum of Digits  [logic]\n",
    "# Return the sum of the digits of a non-negative integer.\n",
    "def digit_sum(n):\n",
    "    return sum([int(i) for i in str(n)])\n",
    "print(digit_sum(1234))   # -> 10\n",
    "print(digit_sum(0))      # -> 0"
   ]
