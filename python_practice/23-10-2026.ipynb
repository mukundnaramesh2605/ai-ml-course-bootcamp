   "source": [
    "# 1. Sum Positives  [Service / logic]\n",
    "# Return the sum of only the positive numbers.\n",
    "# [3, -1, 4, -5, 2] -> 9\n",
    "def sum_positives(nums):\n",
    "    return sum([x for x in nums if x>0])\n",
    "print(sum_positives([3,-1,4,-5,2]))# -> 9 ; \n",
    "print(sum_positives([-1,-2]))# -> 0 ; sum_positives([]) -> 0\n"
   ]
  },
