   "source": [
    "# 1. Average of List  [Service / logic]\n",
    "# Return the average (mean) of the numbers, or 0 for an empty list.\n",
    "# [2,4,6] -> 4.0\n",
    "def average(nums):\n",
    "    if not nums:\n",
    "        return 0\n",
    "    return sum(nums)/len(nums)\n",
    "print(average([2,4,6]))# -> 4.0 ; \n",
    "print(average([]))#-> 0\n"
   ]
