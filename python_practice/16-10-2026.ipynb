   "source": [
    "# 1. Count Words  [Service / string]\n",
    "# Return how many words are in a sentence.\n",
    "# Example: \"I am learning AI\" -> 4\n",
    "def word_count(s):\n",
    "    return len(s.split())\n",
    "print(word_count(\"I am learning AI\"))# -> 4 ; \n",
    "print(word_count(\"\"))# -> 0"
   ]
